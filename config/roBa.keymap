#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <12 13>;
        };

        double {
            bindings = <&kp AT>;
            key-positions = <17 16>;
        };

        semicolon {
            bindings = <&kp SEMI>;
            key-positions = <28 29>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                        &kp T                                                        &kp Y        &kp U  &kp I      &kp O      &lt 6 P
&kp A             &kp S         &kp D         &kp F                        &kp G        &kp LS(LG(S))                    &kp SQT        &kp H        &kp J  &lt 5 K    &lt 4 L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                        &kp B        &kp LS(INTERNATIONAL_1)          &kp APOS       &kp N        &kp M  &kp COMMA  &lt 5 DOT  &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 3 LANGUAGE_2  &lt 2 SPACE  &lt_to_layer_0 3 LANGUAGE_1      &kp BACKSPACE  &lt 1 ENTER                               &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        NUM-FNC {
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F10                                   &kp ASTERISK  &kp N7  &kp N8  &kp N9  &kp PLUS
&trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans          &kp C_VOLUME_UP  &kp SLASH     &kp N4  &kp N5  &kp N6  &kp MINUS
&trans  &kp F1  &kp F2  &kp F3  &kp F12  &kp K_MUTE      &kp C_VOL_DN     &kp N0        &kp N1  &kp N2  &kp N3  &kp DOT
&trans  &trans  &trans  &trans  &trans   &trans          &trans           &trans                                &kp F12
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        KIGOU {
            bindings = <
&kp EXCLAMATION              &kp AT             &kp HASH               &kp DOLLAR       &kp PERCENT                                        &kp CARET  &kp AMPERSAND  &kp MINUS  &kp EQUAL       &kp INTERNATIONAL_3
&kp LESS_THAN                &kp LEFT_BRACKET   &kp LEFT_PARENTHESIS   &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &trans  &trans     &trans         &kp EQUAL  &kp LEFT_BRACE  &trans
&mt LEFT_SHIFT GREATER_THAN  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans  &trans     &trans         &trans     &kp LS(SLASH)   &kp BACKSLASH
&trans                       &trans             &trans                 &trans           &trans        &trans                       &trans  &trans                                               &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE        &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &kp LA(LS(TAB))  &kp LC(PAGE_UP)    &kp UP_ARROW  &kp PAGE_UP    &kp LA(TAB)
&kp HOME          &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &kp HOME         &kp LEFT           &kp DOWN      &kp RIGHT      &kp END
&kp LEFT_SHIFT    &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans           &kp LC(PAGE_DOWN)  &trans        &kp PAGE_DOWN  &trans
&kp LEFT_CONTROL  &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &trans  &mkp MB2
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp HOME  &kp END   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans    &kp LC(PAGE_UP)    &trans  &kp PAGE_UP    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp HOME  &trans             &trans  &trans         &kp END
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &kp LC(PAGE_DOWN)  &trans  &kp PAGE_DOWN  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                              &trans
            >;
        };

        BT {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans  &kp NUMBER_4  &trans        &trans        &trans  &trans      &trans       &studio_unlock  &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans          &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                    &bt BT_CLR_ALL
            >;
        };
    };
};
